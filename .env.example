# FIRST-TIME SETUP (run from the project folder):
#   python3 scripts/setup.py
# This creates your private .env using this template and fills in two random values:
# WORKBENCH_TOKEN = password you paste into the app's Connect field.
# VNC_PASSWORD    = password you enter when opening the browser viewer.
# These are LOCAL access passwords, not LinkedIn passwords or paid-service API keys.
# Do not run Docker with the empty passwords below. Never commit your private .env.

# demo: fictional contacts, no external API calls or invitations.
# live: your own accounts; start with docker compose --profile live up --build -d
WORKBENCH_MODE=demo
WORKBENCH_TOKEN=
VNC_PASSWORD=
DAILY_SEND_LIMIT=10

# Optional Jev assistance for ambiguous Connect controls in the verified profile.
# Get your OWN TypeSafe key at https://console.typesafe.ai/keys.
# Connect and test your key under Your connections in the app (recommended).
# Alternatively set TYPESAFE_API_KEY below. To enable browser assistance,
# set BROWSER_ADVISOR=jev and recreate the app.
# Sends bounded button labels to TypeSafe; API usage may cost money.
# This does not enable the original project's Jev discovery crawler or reply classifier.
BROWSER_ADVISOR=none
TYPESAFE_API_KEY=

# Live discovery uses your Codex sign-in from Your connections and the verified
# LinkedIn browser. Jev is optional for ordering observed links during research.
# Start with a three-profile plan in the UI. Sign-ins persist in the app volume.

# Optional Google sign-in + spreadsheet import. Follow docs/GOOGLE_SHEETS.md.
# Enable Sheets, Drive and Google Picker APIs in ONE Google Cloud project.
# Create a Web OAuth client; save its JSON to secrets/google-oauth-client.json.
# Register the exact callback below and http://localhost:8080 as a JS origin.
# Match the URL you actually open, including any forwarded port.
# GOOGLE_OAUTH_CLIENT_FILE=/run/secrets/google-oauth-client.json
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/connections/google/callback
# GOOGLE_PICKER_API_KEY=your-restricted-google-picker-api-key
# GOOGLE_CLOUD_PROJECT_NUMBER=your-numeric-project-number
# Recreate app, Connect Google, paste URL / choose file, map columns, preview, import.
# Refresh tokens persist privately in the app volume, not in this file.

# Optional Google Sheets export. Leave both blank to use the built-in local CRM.
# Share your spreadsheet with your Google service account, place its downloaded
# JSON key at secrets/google-service-account.json, then fill in these two settings.
GOOGLE_SHEET_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json

# Optional local ports (defaults shown). These are not API keys.
# APP_PORT=8080
# BROWSER_PORT=7900
# The embedded viewer and Open in new tab link use your configured BROWSER_PORT.
# Selenium connects internally through Docker; no Selenium account/key is needed.
# Sign in to LinkedIn IN THE BROWSER. Do not put LinkedIn credentials in this file.
